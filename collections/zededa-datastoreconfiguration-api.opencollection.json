        {
          "info": {
            "name": "Create Datastore",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/datastores",
            "headers": [
              {
                "name": "X-Request-Id",
                "value": ""
              }
            ]
          },
          "docs": "Create a Datastore record."
        },
        {
          "info": {
            "name": "Get datastore",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/datastores/id/:id",
            "headers": [
              {
                "name": "X-Request-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "System defined universally unique Id of the datastore"
              }
            ]
          },
          "docs": "Get the configuration (without security details) of a datastore record."
        },
        {
          "info": {
            "name": "Update datastore",
            "type": "http"
          },
          "http": {
            "method": "PUT",
