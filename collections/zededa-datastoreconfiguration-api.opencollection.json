        {
          "info": {
            "name": "Get datastore",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/datastores/name/:name",
            "headers": [
              {
                "name": "X-Request-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "User defined name of the datastore, unique across the enterprise. Once datastore is created, name can’t be changed."
              }
            ]
          },
          "docs": "Get the configuration (without security details) of a datastore record."
