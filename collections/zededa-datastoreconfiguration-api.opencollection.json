            "headers": [
              {
                "name": "X-Request-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "System defined universally unique Id of the datastore."
              }
            ]
          },
          "docs": "Update a datastore record. The usual pattern to update a datastore record is to retrieve the record and update with the modified values in a new body to update the datastore record."
        },
        {
          "info": {
            "name": "Delete datastore",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/datastores/id/:id",
            "headers": [
              {
                "name": "X-Request-Id",
                "value": ""
              }
