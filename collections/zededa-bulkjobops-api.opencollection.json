        },
        {
          "info": {
            "name": "Update job request to refresh edge application instances",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/v1/jobs/apps/instances/refresh",
            "headers": [
              {
                "name": "X-Request-Id",
                "value": ""
              }
            ]
          },
          "docs": "Update job request to refresh edge application instances matching selection criteria. Update edge application instance(s) to the latest version of the edge application. This operation will result in a restart of the edge application instance(s)."
        },
        {
          "info": {
            "name": "Update job request to refresh and purge edge application instances",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/v1/jobs/apps/instances/refresh/purge",
