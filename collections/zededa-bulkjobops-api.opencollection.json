          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/v1/jobs/apps/bundles/import",
            "headers": [
              {
                "name": "X-Request-Id",
                "value": ""
              }
            ]
          },
          "docs": "Update job request to import edge application bundle(s) from global App Store matching selection criteria."
        },
        {
          "info": {
            "name": "Update job request to create edge application instances",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/v1/jobs/apps/instances/create",
            "headers": [
              {
                "name": "X-Request-Id",
                "value": ""
              }
            ]
          },
